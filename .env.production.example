# ==============================================================================
# PRJ_221 Production Environment Configuration Template
# Use this template for AWS App Runner, ECS, EC2, or Docker Swarm/Kubernetes.
# ==============================================================================

# Database Configuration (AWS RDS PostgreSQL)
DB_HOST=prj221-db-instance.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=prj_221
DB_USER=postgres
DB_PASSWORD=YourStrongDatabasePassword123!

# Security & Authentication
# Generate a cryptographically secure 64+ char key using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ReplaceWith64CharacterRandomUrlSafeTokenGeneratedForProductionUse!

# Faculty Registration Guard
# Set to a strong secret to allow faculty registration via invite code.
# Leave empty to disallow all faculty self-registration.
FACULTY_INVITE_CODE=faculty_secret_passphrase_2026

# Frontend API Endpoint
# URL where your deployed FastAPI backend is accessible from clients
VITE_API_BASE_URL=https://api.yourdomain.com
